{
  "name": "branchlight-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "scripts": {
    "format": "prettier --write src server tests build docs .github/workflows public/manifest.json infra/*.yaml *.yaml *.ts *.json *.md",
    "format:check": "prettier --check src server tests build docs .github/workflows public/manifest.json infra/*.yaml *.yaml *.ts *.json *.md",
    "setup:env": "node server/bootstrapEnv.ts",
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env server/database/migrate.ts",
    "worker": "node --env-file-if-exists=.env server/jobs/worker.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.1",
    "fastify": "^5.12.8",
    "idb": "^8.0.4",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.56.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-git": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  }
}
